# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=Intelligent Small Business Credit Underwriting Assistant
APP_VERSION=1.0.0
APP_ENV=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# -----------------------------------------------------------------------------
# LLM - Google Gemini
# Gemini is optional for the bundled deterministic demo, but recommended for
# the actual hackathon classification/extraction/credit-memo path.
# -----------------------------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=AQ.Ab8RN6Ktg6xenrXJwp7SQkminiBefv9Wsp_VW6r0oBjfhLTlGQ
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_TEMPERATURE=0
MAX_LLM_RETRIES=2
LLM_FALLBACK_ENABLED=true

# -----------------------------------------------------------------------------
# Persistence / file storage
# Local default. Docker Compose overrides this with PostgreSQL.
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/underwriting.db
UPLOAD_DIRECTORY=./data/uploads
MAX_UPLOAD_MB=20

# Optional Windows OCR path if tesseract.exe is not on PATH.
# Example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# -----------------------------------------------------------------------------
# Underwriting configuration
# Illustrative hackathon policies only - not institution-approved credit policy.
# -----------------------------------------------------------------------------
CREDIT_POLICY_PATH=./config/credit_policy.yaml
RISK_SCORECARD_PATH=./config/risk_scorecard.yaml
REVENUE_MISMATCH_TOLERANCE=0.20
LOW_CONFIDENCE_THRESHOLD=0.65
COLLATERAL_MAX_AGE_DAYS=365

# Streamlit only. Local UI defaults to http://localhost:8000 automatically.
API_URL=http://localhost:8000
